# Copia este fichero como .env y sustituye los valores
# (en local ya tienes un .env configurado; no se sube al repositorio)

# Clave de Geoapify (tiles del mapa + Places + geocodificación)
VITE_GEOAPIFY_API_KEY=<TU_CLAVE_GEOAPIFY>

# Configuración Firebase (web client) → Consola Firebase > Ajustes de la app
VITE_FIREBASE_API_KEY=<TU_API_KEY>
VITE_FIREBASE_AUTH_DOMAIN=<tu-proyecto>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<tu-proyecto>
VITE_FIREBASE_STORAGE_BUCKET=<tu-proyecto>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<id>
VITE_FIREBASE_APP_ID=<app-id>
